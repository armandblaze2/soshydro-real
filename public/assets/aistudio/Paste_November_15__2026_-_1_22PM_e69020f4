  bool _isSaving = false;
  final String apiUrl =
      "https://placard-elevator-five.ngrok-free.dev/drive/api_fournisseur.php";

  @override
  void initState() {
    super.initState();
    final d = widget.detaillantData;
    nomBoutiqueController =
        TextEditingController(text: d != null ? d['nom_boutique'] ?? '' : '');
    nomGerantController =
        TextEditingController(text: d != null ? d['nom_gerant'] ?? '' : '');
    quartierController =
        TextEditingController(text: d != null ? d['quartier'] ?? '' : '');
    telController =
        TextEditingController(text: d != null ? d['telephone'] ?? '' : '');
    prix6kgController = TextEditingController(
        text: d != null ? d['prix_bouteille_6kg'].toString() : '5000');
    prix12kgController = TextEditingController(
        text: d != null ? d['prix_bouteille_12kg'].toString() : '18000');
    enStock = d != null ? (d['en_stock'] == 1 || d['en_stock'] == true) : true;
  }

  Future<void> _capturerGpsEtSoumettre() async {
    setState(() => _isSaving = true);

    try {
      Position position = await Geolocator.getCurrentPosition(
        locationSettings:
            const LocationSettings(accuracy: LocationAccuracy.high),
      );
      double lat = position.latitude;
      double lng = position.longitude;
      double precision = position.accuracy;

      if (!mounted) return;

      bool? confirmer = await showDialog<bool>(
        context: context,
        builder: (context) => AlertDialog(
          backgroundColor: const Color(0xFF1E293B),
          title: const Text('Position GPS capturée !'),
          content: Text(
              'Latitude: ${lat.toStringAsFixed(5)}\nLongitude: ${lng.toStringAsFixed(5)}\nPrécision: à ${precision.toStringAsFixed(0)}m près.\n\nVoulez-vous valider ?'),
          actions: [
            TextButton(
                onPressed: () => Navigator.pop(context, false),
                child: const Text('Annuler')),
            ElevatedButton(
                onPressed: () => Navigator.pop(context, true),
                child: const Text('Valider')),
          ],
        ),
      );

      if (confirmer == true) {
        await _envoyerDonnees(lat, lng);
      } else {
        setState(() => _isSaving = false);
      }
    } catch (e) {
      setState(() => _isSaving = false);
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
          content: Text('Erreur GPS : $e'), backgroundColor: Colors.red));
    }
  }

  Future<void> _envoyerDonnees(double lat, double lng) async {
    try {
      final body = {
        "action": "maj_detaillant_gaz",
        "detaillant_id": widget.detaillantData != null
            ? widget.detaillantData!['id'].toString()
            : "0",
        "nom_boutique": nomBoutiqueController.text.trim(),
        "nom_gerant": nomGerantController.text.trim(),
        "quartier": quartierController.text.trim(),
        "telephone": telController.text.trim(),
        "latitude": lat.toString(),
        "longitude": lng.toString(),
        "prix_6kg": prix6kgController.text,
        "prix_12kg": prix12kgController.text,
        "en_stock": enStock ? "1" : "0",
      };

      final response = await http.post(
        Uri.parse(apiUrl),
        body: jsonEncode(body),
        headers: {"Content-Type": "application/json"},
      );

      final data = jsonDecode(response.body);

      if (!mounted) return;
      setState(() => _isSaving = false);

      if (data['status'] == 'success') {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
            content: Text(data['message']), backgroundColor: Colors.green));
        Navigator.pushAndRemoveUntil(
            context,
            MaterialPageRoute(builder: (context) => const AccueilScreen()),
            (route) => false);
      } else {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
            content: Text(data['message'] ?? 'Erreur serveur'),
            backgroundColor: Colors.red));
      }
    } catch (e) {
      setState(() => _isSaving = false);
      ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Erreur : $e'), backgroundColor: Colors.red));
    }
  }

  @override
  Widget build(BuildContext context) {
    bool isModif = widget.detaillantData != null;
    return Scaffold(
      appBar: AppBar(
          backgroundColor: const Color(0xFF1E293B),
          title: Text(
              isModif ? 'Modification Boutique' : 'Création Boutique Gaz')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          children: [
            TextField(
                controller: nomBoutiqueController,
                decoration: const InputDecoration(
                    labelText: 'Nom de la Boutique / Épicerie',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            TextField(
                controller: nomGerantController,
                decoration: const InputDecoration(
                    labelText: 'Nom du Gérant',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            TextField(
                controller: quartierController,
                decoration: const InputDecoration(
                    labelText: 'Quartier (ex: Glass, PK8)',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            TextField(
                controller: telController,
                keyboardType: TextInputType.phone,
                decoration: const InputDecoration(
                    labelText: 'Numéro WhatsApp / Téléphone',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            TextField(
                controller: prix6kgController,
                keyboardType: TextInputType.number,
                decoration: const InputDecoration(
                    labelText: 'Prix Bouteille 6kg',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            TextField(
                controller: prix12kgController,
                keyboardType: TextInputType.number,
                decoration: const InputDecoration(
                    labelText: 'Prix Bouteille 12kg',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            SwitchListTile(
              title: const Text('Gaz en Stock (Disponible)',
                  style: TextStyle(fontSize: 14)),
              value: enStock,
              onChanged: (val) => setState(() => enStock = val),
            ),
            const SizedBox(height: 20),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.blue.shade600,
                    padding: const EdgeInsets.symmetric(vertical: 16)),
                onPressed: _isSaving ? null : _capturerGpsEtSoumettre,
                icon: _isSaving
                    ? const CircularProgressIndicator(color: Colors.white)
                    : const Icon(Icons.my_location),
                label: Text(isModif
                    ? 'Mettre à jour la Boutique'
                    : 'Enregistrer & Ancrer GPS'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
