// 3. FORMULAIRE STATION (Avec GPS Haute Précision)
// ------------------------------------------------------------------
class FormStationScreen extends StatefulWidget {
  final Map<String, dynamic>? stationData;
  const FormStationScreen({super.key, this.stationData});

  @override
  State<FormStationScreen> createState() => _FormStationState();
}

class _FormStationState extends State<FormStationScreen> {
  final List<String> groupes = [
    "TotalEnergies",
    "PetroGabon",
    "Engen",
    "OLA Energy",
    "Gab'Oil"
  ];
  late String nomStation;
  late TextEditingController lieuDitController;
  late TextEditingController telController;
  bool estOuvert = true;

  late TextEditingController prixEssenceController;
  bool dispoEssence = true;
  late TextEditingController prixGazoilController;
  bool dispoGazoil = true;
  late TextEditingController prixPetroleController;
  bool dispoPetrole = true;
  late TextEditingController prixGaz12Controller;
  bool dispoGaz12 = true;
  late TextEditingController prixGaz35Controller;
  bool dispoGaz35 = true;

  bool _isSaving = false;
  final String apiUrl =
      "https://placard-elevator-five.ngrok-free.dev/drive/api_fournisseur.php";

  @override
  void initState() {
    super.initState();
    final d = widget.stationData;
    nomStation = d != null
        ? (groupes.contains(d['nom_station']) ? d['nom_station'] : groupes[0])
        : groupes[0];
    lieuDitController =
        TextEditingController(text: d != null ? d['lieu_dit'] ?? '' : '');
    telController =
        TextEditingController(text: d != null ? d['telephone'] ?? '' : '');
    estOuvert =
        d != null ? (d['est_ouvert'] == 1 || d['est_ouvert'] == true) : true;

    prixEssenceController = TextEditingController(
        text: d != null ? d['prix_essence'].toString() : '850');
    dispoEssence = d != null
        ? (d['dispo_essence'] == 1 || d['dispo_essence'] == true)
        : true;

    prixGazoilController = TextEditingController(
        text: d != null ? d['prix_gazoil'].toString() : '750');
    dispoGazoil = d != null
        ? (d['dispo_gazoil'] == 1 || d['dispo_gazoil'] == true)
        : true;

    prixPetroleController = TextEditingController(
        text: d != null ? d['prix_petrole'].toString() : '650');
    dispoPetrole = d != null
        ? (d['dispo_petrole'] == 1 || d['dispo_petrole'] == true)
        : true;

    prixGaz12Controller = TextEditingController(
        text: d != null ? d['prix_gaz'].toString() : '6000');
    dispoGaz12 =
        d != null ? (d['dispo_gaz'] == 1 || d['dispo_gaz'] == true) : true;

    prixGaz35Controller = TextEditingController(
        text: d != null ? d['prix_gaz_35kg'].toString() : '14000');
    dispoGaz35 = d != null
        ? (d['dispo_gaz_35kg'] == 1 || d['dispo_gaz_35kg'] == true)
        : true;
  }

  Future<void> _capturerGpsEtSoumettre() async {
    setState(() => _isSaving = true);

    try {
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        throw 'Le service de localisation GPS est désactivé.';
      }

      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
        if (permission == LocationPermission.denied) {
          throw 'Les permissions GPS ont été refusées.';
        }
      }

      // Utilisation du paramètre de réglages moderne pour le géolocaliseur
      Position position = await Geolocator.getCurrentPosition(
        locationSettings:
            const LocationSettings(accuracy: LocationAccuracy.high),
      );

      double lat = position.latitude;
      double lng = position.longitude;
      double precision = position.accuracy;

      if (!mounted) return;

      bool? confirmer = await showDialog<bool>(
        context: context,
        builder: (context) => AlertDialog(
          backgroundColor: const Color(0xFF1E293B),
          title: const Text('Position GPS capturée !'),
          content: Text(
              'Latitude: ${lat.toStringAsFixed(5)}\nLongitude: ${lng.toStringAsFixed(5)}\nPrécision: à ${precision.toStringAsFixed(0)}m près.\n\nVoulez-vous valider ?'),
          actions: [
            TextButton(
                onPressed: () => Navigator.pop(context, false),
                child: const Text('Annuler')),
            ElevatedButton(
                onPressed: () => Navigator.pop(context, true),
                child: const Text('Valider')),
          ],
        ),
      );

      if (confirmer == true) {
        await _envoyerDonnees(lat, lng);
      } else {
        setState(() => _isSaving = false);
      }
    } catch (e) {
      setState(() => _isSaving = false);
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
          content: Text('Erreur GPS : $e'), backgroundColor: Colors.red));
    }
  }

  Future<void> _envoyerDonnees(double lat, double lng) async {
    try {
      final body = {
        "action": "mettre_a_jour_station",
        "station_id": widget.stationData != null
            ? widget.stationData!['id'].toString()
            : "0",
        "nom_station": nomStation,
        "lieu_dit": lieuDitController.text.trim(),
        "telephone": telController.text.trim(),
        "latitude": lat.toString(),
        "longitude": lng.toString(),
        "est_ouvert": estOuvert ? "1" : "0",
        "prix_essence": prixEssenceController.text,
        "dispo_essence": dispoEssence ? "1" : "0",
        "prix_gazoil": prixGazoilController.text,
        "dispo_gazoil": dispoGazoil ? "1" : "0",
        "prix_petrole": prixPetroleController.text,
        "dispo_petrole": dispoPetrole ? "1" : "0",
        "prix_gaz_12kg": prixGaz12Controller.text,
        "dispo_gaz_12kg": dispoGaz12 ? "1" : "0",
        "prix_gaz_35kg": prixGaz35Controller.text,
        "dispo_gaz_35kg": dispoGaz35 ? "1" : "0",
      };

      final response = await http.post(
        Uri.parse(apiUrl),
        body: jsonEncode(body),
        headers: {"Content-Type": "application/json"},
      );

      final data = jsonDecode(response.body);

      if (!mounted) return;
      setState(() => _isSaving = false);

      if (data['status'] == 'success') {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
            content: Text(data['message']), backgroundColor: Colors.green));
        Navigator.pushAndRemoveUntil(
            context,
            MaterialPageRoute(builder: (context) => const AccueilScreen()),
            (route) => false);
      } else {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
            content: Text(data['message'] ?? 'Erreur serveur'),
            backgroundColor: Colors.red));
      }
    } catch (e) {
      setState(() => _isSaving = false);
      ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Erreur : $e'), backgroundColor: Colors.red));
    }
  }

  @override
  Widget build(BuildContext context) {
    bool isModif = widget.stationData != null;
    return Scaffold(
      appBar: AppBar(
          backgroundColor: const Color(0xFF1E293B),
          title:
              Text(isModif ? 'Modification Station' : '1er Ancrage Station')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          children: [
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                  color: Colors.amber.withValues(alpha: 0.1),
                  borderRadius: BorderRadius.circular(10),
                  border:
                      Border.all(color: Colors.amber.withValues(alpha: 0.3))),
              child: const Text(
                  'Important : Vous devez être physiquement sur site pour ancrer l\'emplacement GPS exact.',
                  style: TextStyle(fontSize: 11, color: Colors.amberAccent)),
            ),
            const SizedBox(height: 15),
            DropdownButtonFormField<String>(
              value: nomStation,
              dropdownColor: const Color(0xFF1E293B),
              items: groupes
                  .map((g) => DropdownMenuItem(value: g, child: Text(g)))
                  .toList(),
              onChanged: (val) => setState(() => nomStation = val!),
              decoration: const InputDecoration(
                  labelText: 'Groupe / Enseigne',
                  filled: true,
                  fillColor: Color(0xFF1E293B)),
            ),
            const SizedBox(height: 10),
            TextField(
                controller: lieuDitController,
                decoration: const InputDecoration(
                    labelText: 'Lieu-dit exact (ex: Lac bleu)',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            TextField(
                controller: telController,
                keyboardType: TextInputType.phone,
                decoration: const InputDecoration(
                    labelText: 'Téléphone de contact',
                    filled: true,
                    fillColor: Color(0xFF1E293B))),
            const SizedBox(height: 10),
            SwitchListTile(
              title:
                  const Text('Station Ouverte', style: TextStyle(fontSize: 14)),
              value: estOuvert,
              onChanged: (val) => setState(() => estOuvert = val),
            ),
            const Divider(color: Colors.grey),
            _buildCarburantItem('Essence', prixEssenceController, dispoEssence,
                (val) => setState(() => dispoEssence = val)),
            _buildCarburantItem('Gazoil', prixGazoilController, dispoGazoil,
                (val) => setState(() => dispoGazoil = val)),
            _buildCarburantItem('Pétrole', prixPetroleController, dispoPetrole,
                (val) => setState(() => dispoPetrole = val)),
            _buildCarburantItem('Gaz (12kg)', prixGaz12Controller, dispoGaz12,
                (val) => setState(() => dispoGaz12 = val)),
            _buildCarburantItem('Gaz (35kg)', prixGaz35Controller, dispoGaz35,
                (val) => setState(() => dispoGaz35 = val)),
            const SizedBox(height: 20),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.green.shade600,
                    padding: const EdgeInsets.symmetric(vertical: 16)),
                onPressed: _isSaving ? null : _capturerGpsEtSoumettre,
                icon: _isSaving
                    ? const CircularProgressIndicator(color: Colors.white)
                    : const Icon(Icons.my_location),
                label: Text(isModif
                    ? 'Mettre à jour ma Station'
                    : 'Enregistrer & Ancrer GPS'),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildCarburantItem(String nom, TextEditingController controller,
      bool dispo, Function(bool) onDispoChanged) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6.0),
      child: Row(
        children: [
          Expanded(
              flex: 2,
              child: Text(nom,
                  style: const TextStyle(
                      fontSize: 13, fontWeight: FontWeight.bold))),
          Expanded(
            flex: 2,
            child: TextField(
              controller: controller,
              keyboardType: TextInputType.number,
              decoration: const InputDecoration(
                  suffixText: 'F',
                  isDense: true,
                  filled: true,
                  fillColor: Color(0xFF1E293B)),
