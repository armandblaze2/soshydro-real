class AuthStationScreen extends StatefulWidget {
  const AuthStationScreen({super.key});

  @override
  State<AuthStationScreen> createState() => _AuthStationState();
}

class _AuthStationState extends State<AuthStationScreen> {
  final TextEditingController _telController = TextEditingController();
  bool _isLoading = false;
  final String apiUrl =
      "https://placard-elevator-five.ngrok-free.dev/drive/api_fournisseur.php";

  Future<void> _verifierTelephone() async {
    if (_telController.text.trim().isEmpty) return;
    setState(() => _isLoading = true);

    try {
      final response = await http.post(
        Uri.parse(apiUrl),
        body: jsonEncode({
          "action": "auth_station",
          "telephone": _telController.text.trim()
        }),
        headers: {"Content-Type": "application/json"},
      );

      final data = jsonDecode(response.body);

      if (!mounted) return;
      setState(() => _isLoading = false);

      if (data['status'] == 'found') {
        Navigator.pushReplacement(
          context,
          MaterialPageRoute(
              builder: (context) =>
                  FormStationScreen(stationData: data['data'])),
        );
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
              content: Text(
                  'Numéro inconnu : Procédez au premier enregistrement GPS.'),
              backgroundColor: Colors.orange),
        );
        Navigator.pushReplacement(
          context,
          MaterialPageRoute(
              builder: (context) => const FormStationScreen(stationData: null)),
        );
      }
    } catch (e) {
      if (!mounted) return;
      setState(() => _isLoading = false);
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
            content: Text('Erreur réseau : $e'), backgroundColor: Colors.red),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
          backgroundColor: const Color(0xFF1E293B),
          title: const Text('Accès Station-Service',
              style: TextStyle(fontSize: 14))),
      body: Padding(
        padding: const EdgeInsets.all(20.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(Icons.local_gas_station,
                size: 50, color: Colors.blueAccent),
            const SizedBox(height: 15),
            const Text('Entrez votre numéro de téléphone',
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
            const SizedBox(height: 25),
            TextField(
              controller: _telController,
              keyboardType: TextInputType.phone,
              decoration: InputDecoration(
                hintText: '06623XX67',
                filled: true,
                fillColor: const Color(0xFF1E293B),
                border: OutlineInputBorder(
                    borderRadius: BorderRadius.circular(12),
                    borderSide: BorderSide.none),
              ),
            ),
            const SizedBox(height: 20),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.blue.shade600,
                  padding: const EdgeInsets.symmetric(vertical: 14),
                  shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12)),
                ),
                onPressed: _isLoading ? null : _verifierTelephone,
                child: _isLoading
                    ? const CircularProgressIndicator(color: Colors.white)
                    : const Text('Accéder au Tableau de Bord'),
              ),
            ),
            const SizedBox(height: 20),
            TextButton(
              onPressed: () {
                Navigator.pushReplacement(
                    context,
                    MaterialPageRoute(
                        builder: (context) =>
                            const FormStationScreen(stationData: null)));
              },
              child: const Text('Première visite ? Enregistrer ma station',
                  style: TextStyle(color: Colors.greenAccent)),
